# Database
DB_HOST=localhost
DB_NAME=bybit_bot
DB_USER=postgres
DB_PASSWORD=your_password
DB_PORT=5432

# Bybit API (use .env for secrets, NOT config.json)
BYBIT_API_KEY=your_api_key
BYBIT_API_SECRET=your_api_secret

# Discord Webhooks
DISCORD_WEBHOOK_URL=your_alert_webhook
DISCORD_LIVE_WEBHOOK_URL=your_live_webhook
DISCORD_DASHBOARD_WEBHOOK_URL=your_dashboard_webhook

# Bot Environment (production/testing)
BOT_ENV=production
