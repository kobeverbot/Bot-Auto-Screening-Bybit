{
    "api": {
        "discord_webhook": "YOUR_WEBHOOK_URL",
        "discord_live_webhook": "YOUR_LIVE_WEBHOOK_URL",
        "discord_dashboard_webhook": "YOUR_DASHBOARD_WEBHOOK_URL",
        "bybit_key": "YOUR_BYBIT_KEY",
        "bybit_secret": "YOUR_BYBIT_SECRET",
        "discord_server_id": "YOUR_SERVER_ID",
        "discord_role_id": "YOUR_ROLE_ID"
    },
    "database": {
        "host": "localhost",
        "database": "bybit_bot",
        "user": "postgres",
        "password": "YOUR_DB_PASSWORD",
        "port": "5432"
    },
    "system": {
        "timezone": "Asia/Jakarta",
        "max_threads": 20,
        "check_interval_hours": 1,
        "timeframes": ["1h", "4h", "1d", "1w"]
    },
    "setup": {
        "fib_entry_start": 0.5,
        "fib_entry_end": 0.618,
        "fib_sl": 0.27,
        "fib_tp_1": 1.0,
        "fib_tp_2": 1.618,
        "fib_tp_3": 2.618
    },
    "strategy": {
        "min_tech_score": 5,
        "min_quant_score": 3,
        "risk_reward_min": 3.0
    },
    "indicators": {
        "min_rvol": 2.0
    },
    "patterns": {
        "tolerance": 0.015,
        "double_top": true,
        "double_bottom": true,
        "bull_flag": true,
        "bear_flag": true,
        "ascending_triangle": true,
        "descending_triangle": true, 
        "bullish_rectangle": true
    },
    "pattern_signals": {
        "double_bottom": "Long",
        "double_top": "Short",
        "bull_flag": "Long",
        "bear_flag": "Short",
        "ascending_triangle": "Long",
        "descending_triangle": "Short", 
        "bullish_rectangle": "Long"
    },
    "trading": {
        "target_leverage": 25,
        "risk_percent": 0.01,
        "max_positions": 40,
        "max_position_pct": 0.05,
        "trailing_stop_pct": 0.015,
        "trailing_activation_tp": 2
    },
    "circuit_breaker": {
        "enabled": true,
        "max_daily_loss_pct": 0.05,
        "max_consecutive_losses": 5,
        "pause_minutes_on_consecutive": 60,
        "max_daily_trades": 50,
        "max_open_exposure_pct": 2.0
    },
    "rate_limiter": {
        "max_calls": 20,
        "per_seconds": 1,
        "burst": 10
    }
}