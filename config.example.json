{
    "api": {
        "discord_webhook": "YOUR_WEBHOOK_URL",
        "discord_live_webhook": "YOUR_LIVE_WEBHOOK_URL",
        "discord_dashboard_webhook": "YOUR_DASHBOARD_WEBHOOK_URL",
        "bybit_key": "YOUR_BYBIT_KEY",
        "bybit_secret": "YOUR_BYBIT_SECRET",
        "discord_server_id": "YOUR_SERVER_ID",
        "discord_role_id": "YOUR_ROLE_ID"
    },
    "database": {
        "host": "localhost",
        "database": "bybit_bot",
        "user": "postgres",
        "password": "YOUR_DB_PASSWORD",
        "port": "5432"
    },
    "system": {
        "timezone": "Asia/Jakarta",
        "max_threads": 20,
        "check_interval_hours": 1,
        "timeframes": ["1h", "4h", "1d", "1w"]
    },
    "setup": {
        "fib_entry_start": 0.5,
        "fib_entry_end": 0.618,
        "fib_sl": 0.27,
        "fib_tp_1": 1.0,
        "fib_tp_2": 1.618,
        "fib_tp_3": 2.618
    },
    "strategy": {
        "min_tech_score": 5,
        "min_quant_score": 3,
        "risk_reward_min": 3.0
    },
    "indicators": {
        "min_rvol": 2.0
    },
    "patterns": {
        "tolerance": 0.015,
        "double_top": true,
        "double_bottom": true,
        "bull_flag": true,
        "bear_flag": true,
        "ascending_triangle": true,
        "descending_triangle": true, 
        "bullish_rectangle": true,
        "rising_wedge": true,
        "falling_wedge": true,
        "head_and_shoulders": true,
        "inverse_head_and_shoulders": true,
        "cup_and_handle": true
    },
    "pattern_signals": {
        "double_bottom": "Long",
        "double_top": "Short",
        "bull_flag": "Long",
        "bear_flag": "Short",
        "ascending_triangle": "Long",
        "descending_triangle": "Short", 
        "bullish_rectangle": "Long",
        "rising_wedge": "Short",
        "falling_wedge": "Long",
        "head_and_shoulders": "Short",
        "inverse_head_and_shoulders": "Long",
        "cup_and_handle": "Long"
    },
    "trading": {
        "target_leverage": 25,
        "risk_percent": 0.01,
        "max_positions": 40,
        "max_position_pct": 0.05,
        "trailing_stop_pct": 0.015,
        "trailing_activation_tp": 2
    },
    "circuit_breaker": {
        "enabled": true,
        "max_daily_loss_pct": 0.05,
        "max_consecutive_losses": 5,
        "pause_minutes_on_consecutive": 60,
        "max_daily_trades": 50,
        "max_open_exposure_pct": 2.0
    },
    "dynamic_risk": {
        "enabled": true,
        "natr_length": 14,
        "adx_length": 14,
        "volatility_buckets": {
            "calm":     {"natr_max": 2.0,  "leverage_mult": 1.3, "risk_mult": 1.2, "max_pos_mult": 1.2},
            "normal":   {"natr_max": 5.0,  "leverage_mult": 1.0, "risk_mult": 1.0, "max_pos_mult": 1.0},
            "volatile": {"natr_max": 10.0, "leverage_mult": 0.6, "risk_mult": 0.7, "max_pos_mult": 0.7},
            "extreme":  {"natr_max": 999.0, "leverage_mult": 0.3, "risk_mult": 0.4, "max_pos_mult": 0.5}
        },
        "adx_threshold": 25.0,
        "trending_leverage_bonus": 0.2,
        "target_leverage": 25,
        "min_leverage": 1,
        "max_leverage": 50,
        "sl_atr_min": 0.5,
        "sl_atr_max": 4.0
    },
    "rate_limiter": {
        "max_calls": 20,
        "per_seconds": 1,
        "burst": 10
    },
    "backtest": {
        "lookback_days": 90,
        "timeframe": "4h",
        "max_pairs": 20,
        "cooldown_bars": 10,
        "max_bars_simulation": 100
    },
    "ml_scoring": {
        "enabled": false,
        "mode": "augment",
        "model_path": "ml_models/signal_model.json",
        "min_training_samples": 50,
        "augment_score_range": [0, 5],
        "replace_score_weights": {
            "tech_score": 1.0,
            "smc_score": 1.2,
            "quant_score": 0.8,
            "deriv_score": 1.0,
            "ml_confidence": 2.0
        },
        "heuristic_weights": {
            "tech_score": 1.0,
            "smc_score": 1.5,
            "quant_score": 0.8,
            "deriv_score": 1.2,
            "zeta_score": 0.03,
            "z_score": 0.1,
            "obi": 1.5,
            "rr_bonus": 0.5
        },
        "features": {
            "numeric": [
                "tech_score", "smc_score", "quant_score", "deriv_score",
                "z_score", "zeta_score", "obi", "basis", "rr"
            ],
            "categorical": ["pattern", "side", "btc_bias"],
            "derived": ["total_score", "score_balance", "smc_tech_ratio"]
        }
    }
}